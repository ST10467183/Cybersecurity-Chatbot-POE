<Window x:Class="CybersecurityChatbot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot" 
        Height="650" 
        Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1a1a2e"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#6c3483"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="#1a1a2e"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#6c3483"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="DatePickerTextBox">
            <Setter Property="Background" Value="#1a1a2e"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#6c3483"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#0a0a1a"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0f3460" Padding="15" Margin="10" CornerRadius="10" BorderBrush="#6c3483" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="╔════════════════════════════════════════════════════════════════════╗" 
                           FontFamily="Consolas" FontSize="9" Foreground="#6c3483" HorizontalAlignment="Center"/>
                <TextBlock Text="║                                                                            ║" 
                           FontFamily="Consolas" FontSize="9" Foreground="#6c3483" HorizontalAlignment="Center"/>
                <TextBlock Text="║    ██████╗██╗   ██╗██████╗ ███████╗██████╗ ██████╗  ██████╗ ████████╗      ║" 
                           FontFamily="Consolas" FontSize="9" Foreground="#6c3483" HorizontalAlignment="Center"/>
                <TextBlock Text="║    ██      ╚██╗ ██╔╝██╔══██╗██╔════╝██╔══██╗██╔══██╗██╔═══██╗╚══██╔══╝      ║" 
                           FontFamily="Consolas" FontSize="9" Foreground="#6c3483" HorizontalAlignment="Center"/>
                <TextBlock Text="║    ██       ╚████╔╝ ██████╔╝█████╗  ██████╔╝██████╔╝██║   ██║   ██║         ║" 
                           FontFamily="Consolas" FontSize="9" Foreground="#6c3483" HorizontalAlignment="Center"/>
                <TextBlock Text="║    ██        ╚██╔╝  ██╔══██╗██╔══╝  ██╔══██╗██╔══██╗██║   ██║   ██║         ║" 
                           FontFamily="Consolas" FontSize="9" Foreground="#6c3483" HorizontalAlignment="Center"/>
                <TextBlock Text="║    ██████╔╝   ██║   ██████╔╝███████╗██║  ██║██████╔╝╚██████╔╝   ██║         ║" 
                           FontFamily="Consolas" FontSize="9" Foreground="#6c3483" HorizontalAlignment="Center"/>
                <TextBlock Text="║    ╚═════╝    ╚═╝   ╚═════╝ ╚══════╝╚═╝  ╚═╝╚═════╝  ╚═════╝    ╚═╝         ║" 
                           FontFamily="Consolas" FontSize="9" Foreground="#6c3483" HorizontalAlignment="Center"/>
                <TextBlock Text="║                                                                            ║" 
                           FontFamily="Consolas" FontSize="9" Foreground="#6c3483" HorizontalAlignment="Center"/>
                <TextBlock Text="║                         C Y B E R B O T                                   ║" 
                           FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="#6c3483" HorizontalAlignment="Center"/>
                <TextBlock Text="║                                                                            ║" 
                           FontFamily="Consolas" FontSize="9" Foreground="#6c3483" HorizontalAlignment="Center"/>
                <TextBlock Text="║                    🔒  C Y B E R S E C U R I T Y  🔒                        ║" 
                           FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#6c3483" HorizontalAlignment="Center"/>
                <TextBlock Text="║                      Your first line of defense online                    ║" 
                           FontFamily="Consolas" FontSize="9" Foreground="#d2b4de" HorizontalAlignment="Center"/>
                <TextBlock Text="║                                                                            ║" 
                           FontFamily="Consolas" FontSize="9" Foreground="#6c3483" HorizontalAlignment="Center"/>
                <TextBlock Text="╚════════════════════════════════════════════════════════════════════╝" 
                           FontFamily="Consolas" FontSize="9" Foreground="#6c3483" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Margin="10" Background="#1a1a2e" BorderBrush="#6c3483" BorderThickness="1">

            <!-- Chat Tab -->
            <TabItem Header="Chat" Foreground="#6c3483" FontWeight="Bold">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox x:Name="ChatDisplay" 
                             Grid.Row="0" 
                             Margin="10" 
                             Background="#0a0a1a" 
                             Foreground="White" 
                             FontSize="14"
                             FontFamily="Segoe UI"
                             BorderBrush="#0f3460" 
                             BorderThickness="2"/>

                    <Border Grid.Row="1" Background="#0f3460" Padding="10" Margin="10" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="UserInput" 
                                     Grid.Column="0" 
                                     Height="45" 
                                     FontSize="14" 
                                     FontFamily="Segoe UI"
                                     Background="#1a1a2e" 
                                     Foreground="White"
                                     BorderBrush="#6c3483"
                                     BorderThickness="1"
                                     KeyDown="UserInput_KeyDown"/>

                            <Button x:Name="SendButton" 
                                    Grid.Column="1" 
                                    Width="90" 
                                    Height="45" 
                                    Margin="10,0,0,0"
                                    Content="SEND" 
                                    FontSize="14" 
                                    FontWeight="Bold"
                                    Background="#6c3483" 
                                    Foreground="#1a1a2e"
                                    Cursor="Hand"
                                    Click="SendButton_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tasks Tab -->
            <TabItem Header="Tasks" Foreground="#6c3483" FontWeight="Bold">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Add Task -->
                    <Border Grid.Row="0" Background="#0f3460" Padding="15" Margin="5" CornerRadius="8" BorderBrush="#6c3483" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Add New Task" FontWeight="Bold" Foreground="#6c3483" FontSize="16" Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Title:" Foreground="#d2b4de" Margin="5,0,5,5"/>
                                <TextBox x:Name="TaskTitle" Grid.Row="1" Grid.Column="0" Height="30" Margin="5" Background="#1a1a2e" Foreground="White" BorderBrush="#6c3483" BorderThickness="1"/>

                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Description:" Foreground="#d2b4de" Margin="5,0,5,5"/>
                                <TextBox x:Name="TaskDescription" Grid.Row="1" Grid.Column="1" Height="30" Margin="5" Background="#1a1a2e" Foreground="White" BorderBrush="#6c3483" BorderThickness="1"/>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="Reminder Date:" Foreground="#d2b4de" VerticalAlignment="Center" Margin="5,0,10,0"/>
                                    <DatePicker x:Name="TaskReminderDate" Height="30" Background="#1a1a2e" Foreground="White" BorderBrush="#6c3483" BorderThickness="1"/>
                                </StackPanel>

                                <Button x:Name="AddTaskButton" Grid.Column="1" Content="Add Task" Width="100" Height="35" Background="#6c3483" Foreground="White" FontWeight="Bold" Click="AddTaskButton_Click" Margin="10,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Task List -->
                    <Border Grid.Row="1" Background="#0f3460" Padding="15" Margin="5" CornerRadius="8" BorderBrush="#6c3483" BorderThickness="1">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Your Tasks" FontWeight="Bold" Foreground="#6c3483" FontSize="16"/>
                                <Button x:Name="RefreshTasksButton" Grid.Column="1" Content="Refresh" Width="80" Height="30" Background="#6c3483" Foreground="White" FontWeight="Bold" Click="RefreshTasksButton_Click"/>
                            </Grid>

                            <ListBox x:Name="TaskListBox" Margin="0,10,0,0" Height="180" Background="#0a0a1a" Foreground="White" BorderBrush="#6c3483" BorderThickness="1">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#6c3483" BorderThickness="0,0,0,1" Padding="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Id}" Width="30" Foreground="#d2b4de"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="10,0" Foreground="White" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Description}" Foreground="White" Margin="10,0"/>
                                                <TextBlock Grid.Column="3" Text="{Binding IsCompleted}" Width="80" Foreground="#6c3483" Margin="10,0"/>
                                                <StackPanel Grid.Column="4" Orientation="Horizontal">
                                                    <Button Content="Complete" Tag="{Binding Id}" Click="CompleteTaskButton_Click" Background="#6c3483" Foreground="White" Width="70" Margin="5,0"/>
                                                    <Button Content="Delete" Tag="{Binding Id}" Click="DeleteTaskButton_Click" Background="#6c3483" Foreground="White" Width="70" Margin="5,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Quiz Tab -->
            <TabItem Header="Quiz" Foreground="#6c3483" FontWeight="Bold">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#0f3460" Padding="15" Margin="5" CornerRadius="8" BorderBrush="#6c3483" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="QuizQuestionDisplay" Text="Click Start Quiz to begin!" FontSize="16" Foreground="White" TextWrapping="Wrap" FontWeight="Bold"/>
                            <TextBlock x:Name="QuizProgressDisplay" Text="0 / 0" Foreground="#d2b4de" FontSize="12" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="5">
                        <Button x:Name="QuizOption1" Content="A" Height="35" Margin="5" Background="#1a1a2e" Foreground="White" BorderBrush="#6c3483" BorderThickness="1" Click="QuizOption_Click" Tag="0"/>
                        <Button x:Name="QuizOption2" Content="B" Height="35" Margin="5" Background="#1a1a2e" Foreground="White" BorderBrush="#6c3483" BorderThickness="1" Click="QuizOption_Click" Tag="1"/>
                        <Button x:Name="QuizOption3" Content="C" Height="35" Margin="5" Background="#1a1a2e" Foreground="White" BorderBrush="#6c3483" BorderThickness="1" Click="QuizOption_Click" Tag="2"/>
                        <Button x:Name="QuizOption4" Content="D" Height="35" Margin="5" Background="#1a1a2e" Foreground="White" BorderBrush="#6c3483" BorderThickness="1" Click="QuizOption_Click" Tag="3"/>
                    </StackPanel>

                    <Border Grid.Row="2" Background="#0f3460" Padding="10" Margin="5" CornerRadius="8" BorderBrush="#6c3483" BorderThickness="1">
                        <TextBlock x:Name="QuizFeedbackDisplay" Text="Select an answer to see feedback" Foreground="#d2b4de" FontSize="14" TextWrapping="Wrap"/>
                    </Border>

                    <Button x:Name="StartQuizButton" Grid.Row="3" Content="Start Quiz" Height="45" Margin="5" Background="#6c3483" Foreground="White" FontWeight="Bold" FontSize="16" Click="StartQuizButton_Click" VerticalAlignment="Bottom"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>