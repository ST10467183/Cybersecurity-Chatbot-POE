<Window x:Class="CybersecurityChatbot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot" 
        Height="600" 
        Width="800"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#1a1a2e" Offset="0"/>
                <GradientStop Color="#16213e" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with ASCII Art -->
        <Border Grid.Row="0" Background="#0f3460" Padding="10" Margin="5">
            <TextBlock Text="
╔══════════════════════════════════════════════════════════════════════════════╗
║                                                                              ║
║    _____         _   _                 _        _        _                   ║
║   / ____|       | | | |               | |      | |      | |                  ║
║  | |     ___  __| | | |__   ___  _ __ | |_ __ _| |_ __ _| |_                 ║
║  | |    / _ \/ _` | | '_ \ / _ \| '_ \| __/ _` | __/ _` | __|                ║
║  | |___|  __/ (_| | | | | | (_) | | | | || (_| | || (_| | |_                 ║
║   \_____\___|\__,_| |_| |_|\___/|_| |_|\__\__,_|\__\__,_|\__|                ║
║                                                                              ║
╚══════════════════════════════════════════════════════════════════════════════╝"
                       FontFamily="Consolas" 
                       FontSize="10" 
                       Foreground="#00ff9d" 
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Chat Display Area -->
        <ListBox x:Name="ChatDisplay" 
                 Grid.Row="1" 
                 Margin="10" 
                 Background="#0a0a1a" 
                 Foreground="White" 
                 FontFamily="Consolas" 
                 FontSize="14"
                 BorderBrush="#0f3460" 
                 BorderThickness="2">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Input Area -->
        <Border Grid.Row="2" 
                Background="#0f3460" 
                Padding="10" 
                Margin="5" 
                CornerRadius="5">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="UserInput" 
                         Grid.Column="0" 
                         Height="40" 
                         VerticalContentAlignment="Center"
                         FontSize="14" 
                         FontFamily="Consolas"
                         Background="#1a1a2e" 
                         Foreground="#00ff9d"
                         BorderBrush="#2d3561"
                         BorderThickness="2"
                         KeyDown="UserInput_KeyDown"/>

                <Button x:Name="SendButton" 
                        Grid.Column="1" 
                        Width="80" 
                        Height="40" 
                        Margin="10,0,0,0"
                        Content="SEND" 
                        FontSize="14" 
                        FontWeight="Bold"
                        Background="#00ff9d" 
                        Foreground="#0a0a1a"
                        Click="SendButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>