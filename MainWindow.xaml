<Window x:Class="CybersecurityChatbot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot" 
        Height="650" 
        Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--  -->
        <Border Grid.Row="0" Background="#0f3460" Padding="15" Margin="10" CornerRadius="10" BorderBrush="#6c3483" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="╔════════════════════════════════════════════════════════════════════╗" 
                           FontFamily="Consolas" FontSize="9" Foreground="#6c3483" HorizontalAlignment="Center"/>
                <TextBlock Text="║                                                                            ║" 
                           FontFamily="Consolas" FontSize="9" Foreground="#6c3483" HorizontalAlignment="Center"/>
                <TextBlock Text="║    ██████╗██╗   ██╗██████╗ ███████╗██████╗ ██████╗  ██████╗ ████████╗      ║" 
                           FontFamily="Consolas" FontSize="9" Foreground="#6c3483" HorizontalAlignment="Center"/>
                <TextBlock Text="║    ██      ╚██╗ ██╔╝██╔══██╗██╔════╝██╔══██╗██╔══██╗██╔═══██╗╚══██╔══╝      ║" 
                           FontFamily="Consolas" FontSize="9" Foreground="#6c3483" HorizontalAlignment="Center"/>
                <TextBlock Text="║    ██       ╚████╔╝ ██████╔╝█████╗  ██████╔╝██████╔╝██║   ██║   ██║         ║" 
                           FontFamily="Consolas" FontSize="9" Foreground="#6c3483" HorizontalAlignment="Center"/>
                <TextBlock Text="║    ██        ╚██╔╝  ██╔══██╗██╔══╝  ██╔══██╗██╔══██╗██║   ██║   ██║         ║" 
                           FontFamily="Consolas" FontSize="9" Foreground="#6c3483" HorizontalAlignment="Center"/>
                <TextBlock Text="║    ██████╔╝   ██║   ██████╔╝███████╗██║  ██║██████╔╝╚██████╔╝   ██║         ║" 
                           FontFamily="Consolas" FontSize="9" Foreground="#6c3483" HorizontalAlignment="Center"/>
                <TextBlock Text="║    ╚═════╝    ╚═╝   ╚═════╝ ╚══════╝╚═╝  ╚═╝╚═════╝  ╚═════╝    ╚═╝         ║" 
                           FontFamily="Consolas" FontSize="9" Foreground="#6c3483" HorizontalAlignment="Center"/>
                <TextBlock Text="║                                                                            ║" 
                           FontFamily="Consolas" FontSize="9" Foreground="#6c3483" HorizontalAlignment="Center"/>
                <TextBlock Text="║                         C Y B E R B O T                                   ║" 
                           FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="#6c3483" HorizontalAlignment="Center"/>
                <TextBlock Text="║                                                                            ║" 
                           FontFamily="Consolas" FontSize="9" Foreground="#6c3483" HorizontalAlignment="Center"/>
                <TextBlock Text="║                    🔒  C Y B E R S E C U R I T Y  🔒                        ║" 
                           FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#6c3483" HorizontalAlignment="Center"/>
                <TextBlock Text="║                      Your first line of defense online                    ║" 
                           FontFamily="Consolas" FontSize="9" Foreground="#d2b4de" HorizontalAlignment="Center"/>
                <TextBlock Text="║                                                                            ║" 
                           FontFamily="Consolas" FontSize="9" Foreground="#6c3483" HorizontalAlignment="Center"/>
                <TextBlock Text="╚════════════════════════════════════════════════════════════════════╝" 
                           FontFamily="Consolas" FontSize="9" Foreground="#6c3483" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- -->
        <ListBox x:Name="ChatDisplay" 
                 Grid.Row="1" 
                 Margin="10" 
                 Background="#0a0a1a" 
                 Foreground="White" 
                 FontSize="14"
                 FontFamily="Segoe UI"
                 BorderBrush="#0f3460" 
                 BorderThickness="2"/>

        <!-- -->
        <Border Grid.Row="2" Background="#0f3460" Padding="10" Margin="10" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="UserInput" 
                         Grid.Column="0" 
                         Height="45" 
                         FontSize="14" 
                         FontFamily="Segoe UI"
                         Background="#1a1a2e" 
                         Foreground="#6c3483"
                         BorderBrush="#6c3483"
                         BorderThickness="1"
                         KeyDown="UserInput_KeyDown"/>

                <Button x:Name="SendButton" 
                        Grid.Column="1" 
                        Width="90" 
                        Height="45" 
                        Margin="10,0,0,0"
                        Content="🚀 SEND" 
                        FontSize="14" 
                        FontWeight="Bold"
                        Background="#6c3483" 
                        Foreground="#1a1a2e"
                        Cursor="Hand"
                        Click="SendButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>